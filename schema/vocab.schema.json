    "resourceType": {
      "type": "string",
      "enum": [
        "dataset",
        "service",
        "document",
        "software",
        "model"
      ],
      "description": "Kind of resource a record describes."
    },
    "access": {
      "type": "string",
      "enum": [
        "public",
        "restricted",
        "internal"
      ],
      "description": "Access condition of a resource or of one of its access points. Always explicit: it is never assumed to be public."
    },
    "dataKind": {
      "type": "string",
      "enum": [
        "raster",
        "vector",
        "tabular",
        "document",
        "mixed",
        "other"
      ],
      "description": "What kind of data an access point leads to. Drives the 'data type' facet and which detail block applies."
    },
    "accessMethod": {
      "type": "string",
      "enum": [
        "download",
        "landing_page",
        "service",
        "request"
      ],
      "description": "How an access point is used: download a file, visit a page, call a service, or ask for the data."
    },
    "contactRole": {
      "type": "string",
      "enum": [
        "producer",
        "licensor",
        "host",
        "processor",
        "point-of-contact",
        "maintainer",
        "funder"
      ],
      "description": "Role a person or organization plays for a resource."
    },
    "relation": {
      "type": "string",
      "enum": [
        "IsSupplementTo",
        "IsDocumentedBy",
        "IsSupplementedBy",
        "IsDerivedFrom",
        "IsSourceOf",
        "IsPartOf",
        "HasPart",
        "IsNewVersionOf",
        "IsPreviousVersionOf",
        "IsCitedBy",
        "References",
        "IsVariantFormOf"
      ],
      "description": "How a related resource relates to this one (DataCite relation types, subset)."
    },
    "updateFrequency": {
      "type": "string",
      "enum": [
        "static",
        "continual",
        "daily",
        "weekly",
        "monthly",
        "quarterly",
        "seasonal",
        "annual",
        "irregular",
        "unknown"
      ],
